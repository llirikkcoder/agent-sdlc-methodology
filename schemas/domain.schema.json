{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softoscope.local/schemas/domain.schema.json",
  "title": "Softoscope layer 2: entities, states, transitions, relations",
  "description": "Декларативный граф сущностей предметной области. Имена сущностей — PascalCase латиницей, состояния и атрибуты — snake_case.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "system_id",
    "entities"
  ],
  "properties": {
    "system_id": {
      "$ref": "#/$defs/id"
    },
    "entities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entity"
      }
    },
    "domain_events": {
      "type": "array",
      "description": "Доменные события сверх базового каталога (см. docs/02-event-sourcing.md). Имя — PascalCase.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "entity",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          },
          "entity": {
            "$ref": "#/$defs/entity_name"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "imports": {
      "type": "array",
      "description": "Сущности других систем, на которые можно ссылаться (ref, relations, touches_entities, applies_to, scope.entity). Переходы и агрегаты процессов — только свои сущности (ADR-016).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "system_id",
          "entities"
        ],
        "properties": {
          "system_id": {
            "$ref": "#/$defs/id"
          },
          "entities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/entity_name"
            }
          },
          "source": {
            "type": "string",
            "description": "Где лежит модель системы-владельца (путь/репозиторий)."
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "entity_name": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "identity",
        "attributes"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 3
        },
        "identity": {
          "type": "string",
          "description": "Имя атрибута-идентификатора (aggregate id в событиях)."
        },
        "attributes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "boolean",
                  "datetime",
                  "date",
                  "json",
                  "ref",
                  "list"
                ]
              },
              "required": {
                "type": "boolean",
                "default": false
              },
              "description": {
                "type": "string"
              },
              "enum": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ref": {
                "$ref": "#/$defs/entity_name",
                "description": "Для type=ref: на какую сущность ссылается."
              },
              "sensitive": {
                "type": "boolean",
                "default": false,
                "description": "Персональные или иначе чувствительные данные: события не должны нести их в payload открытым текстом."
              }
            }
          }
        },
        "states": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "initial_state": {
          "$ref": "#/$defs/id"
        },
        "terminal_states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "derived_state": {
          "type": "boolean",
          "default": false,
          "description": "true — состояние вычисляется из других сущностей (проекция), а не хранится первично."
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "$ref": "#/$defs/id"
              },
              "to": {
                "$ref": "#/$defs/id"
              },
              "trigger": {
                "type": "string",
                "description": "Что вызывает переход: шаг процесса, событие, действие."
              },
              "actor_kind": {
                "enum": [
                  "human",
                  "agent",
                  "system"
                ]
              },
              "reversible": {
                "type": "boolean",
                "description": "Есть ли переход, возвращающий в from (или компенсация)."
              },
              "guard": {
                "type": "string",
                "description": "Условие перехода словами или ссылкой на ограничение Cnnn."
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "target",
              "cardinality"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/id"
              },
              "target": {
                "$ref": "#/$defs/entity_name"
              },
              "cardinality": {
                "enum": [
                  "one",
                  "many"
                ]
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "invariants": {
          "type": "array",
          "description": "Локальные инварианты сущности словами. Глобальные — в слое 1.",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
